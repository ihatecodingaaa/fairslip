# FairSlip backend environment. Copy to .env and fill in.
# Real keys never enter this file, and .env itself is gitignored.

# --- Vision readers (Stage 2) ---------------------------------------------
# Reader A: Claude, via the Anthropic API.
ANTHROPIC_API_KEY=

# Reader B: a second vendor's vision model, called against OpenAI's own API.
# Two vendors on purpose: two models from one family tend to share their
# mistakes, and a shared mistake arrives as an AGREED, which is the one thing
# this design cannot catch. Direct rather than through an aggregator, so the two
# readers share no account, no balance and no outage.
OPENAI_API_KEY=

# The model pick, visible in the deployment rather than compiled into a
# constant. Defaults are in fairslip/extract.py; the reasoning is in
# docs/reader-models.md.
FAIRSLIP_READER_A_MODEL=claude-haiku-4-5
FAIRSLIP_READER_B_MODEL=gpt-5.6-luna

# --- Transport -------------------------------------------------------------
# Comma-separated origins allowed to call the API.
FAIRSLIP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
